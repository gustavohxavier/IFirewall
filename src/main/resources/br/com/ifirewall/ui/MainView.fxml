<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.ifirewall.ui.MainViewController">
   <top>
      <VBox spacing="2.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="section-title" text="🧱 IFirewall – Gerador de regras de filtragem" />
            <Label styleClass="hint-label" text="Monte regras de firewall arrastando blocos coloridos — sem decorar comandos!" />
         </children>
         <padding>
            <Insets bottom="6.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </VBox>
   </top>
   <left>
      <VBox fx:id="toolbox" prefWidth="230.0" spacing="8.0" styleClass="panel" BorderPane.alignment="TOP_CENTER">
         <children>
            <Label styleClass="section-title" text="🧰 Caixa de Blocos" />
            <Label styleClass="hint-label" text="Arraste os blocos para o canvas →" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="16.0" left="16.0" right="8.0" top="8.0" />
         </BorderPane.margin>
      </VBox>
   </left>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="section-title" text="🎨 Canvas — solte os blocos aqui para compor sua regra" />
            <Pane fx:id="canvas" styleClass="canvas-area" VBox.vgrow="ALWAYS" />
            <Label fx:id="draftLabel" styleClass="draft-label" text="Regra atual:" wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="🔌 Porta:" />
                  <TextField fx:id="portField" prefWidth="80.0" promptText="ex: 22" />
                  <Label text="🌐 IP origem:" />
                  <TextField fx:id="sourceIpField" prefWidth="140.0" promptText="ex: 192.168.0.1" />
                  <Button onAction="#onAddRule" styleClass="button-primary" text="➕ Adicionar Regra" />
                  <Button onAction="#onClear" styleClass="button-soft" text="🧹 Novo / Limpar" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Button onAction="#onCopyScript" text="📋 Copiar Script" />
                  <Button onAction="#onExportTxt" text="📄 Gerar .txt" />
                  <Button onAction="#onExportSh" text="🐧 Gerar .sh" />
                  <Button onAction="#onSaveProject" text="💾 Salvar" />
                  <Button onAction="#onOpenProject" text="📂 Abrir" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="560.0" minWidth="480.0" spacing="6.0" styleClass="panel" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="section-title" text="👁 Pré-visualização do Script" />
            <Label styleClass="hint-label" text="O comando iptables é gerado em tempo real conforme você monta." wrapText="true" />
            <TextArea fx:id="livePreviewTextArea" editable="false" VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="16.0" left="8.0" right="16.0" top="8.0" />
         </BorderPane.margin>
      </VBox>
   </right>
</BorderPane>
